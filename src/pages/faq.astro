---
import Base from '../layouts/Base.astro';
import Heading from '../components/Heading.astro';
import Button from '../components/Button.astro';
import Accordion from '../components/Accordion.astro';
import { faq } from '../data/content';
import { contact, tel } from '../data/site';
import { reveal } from '../lib/ui';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<Base title="Häufige Fragen" description="Antworten zu Bezugstermin, Bewerbung, Unterlagen, Haustieren, Parkplätzen, Besichtigung, Sauna, Schwimmteich und Schrebergärten von auréa in Reichenburg SZ.">
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} slot="head" />
  <section data-tone="sand" class="bg-sand px-20 py-50 text-olive md:px-64 lg:py-140">
    <div class:list={['mx-auto max-w-narrow', reveal]} data-reveal>
      <Heading as="h1">häufige fragen.</Heading>
      <Accordion items={faq} class="mt-30 lg:mt-50" />

      <h2 class="mt-60 text-h4 font-bold lg:mt-90">Ihre Frage ist nicht dabei?</h2>
      <p class="mt-20">
        Wir sind gerne für Sie da: {contact.company}, <a href={tel(contact.phone)} class="whitespace-nowrap hover:underline">{contact.phone}</a>,{' '}
        <a href={`mailto:${contact.email}`} class="hover:underline">{contact.email}</a>
      </p>
      <div class="mt-30 flex justify-end"><Button href={`mailto:${contact.email}`} tone="olive">e-mail schreiben</Button></div>
    </div>
  </section>
</Base>
