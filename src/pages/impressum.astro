---
import Legal from '../layouts/Legal.astro';
import { contact, tel } from '../data/site';
---

<Legal title="Impressum" heading="impressum." description="Impressum von auréa in Reichenburg SZ – Vermarktung, Design und Programmierung.">
  <h2>Vermarktung Erstvermietung</h2>
  <p>
    {contact.company}<br />
    {contact.street}<br />
    {contact.postalCode} {contact.city}<br />
    <a href={tel(contact.phone)}>{contact.phone}</a><br />
    <a href={`mailto:${contact.email}`}>{contact.email}</a>
  </p>

  <h2>Design und Entwicklung</h2>
  <p>
    Stoz Werbeagentur AG<br />
    Barzloostrasse 2<br />
    8330 Pfäffikon ZH<br />
    <a href="mailto:hello@stoz.ch">hello@stoz.ch</a><br />
    <a href="https://www.stoz.ch" target="_blank" rel="noopener">www.stoz.ch</a>
  </p>

  <h2>Programmierung</h2>
  <p>
    Marcel Stadelmann, Zürich<br />
    <a href="https://marceli.to" target="_blank" rel="noopener">marceli.to</a>
  </p>

  <h2>Visualisierungen</h2>
  <p>Die Visualisierungen sind unverbindlich. Änderungen in Ausführung und Ausstattung bleiben vorbehalten.</p>
</Legal>
