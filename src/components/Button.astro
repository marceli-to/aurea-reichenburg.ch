---
// Link on the hand-drawn blob from the design (Figma «Button»: 18 px bold, 14/15 px top/bottom, 26 px sides). Sand blob with olive text on white and olive
// backgrounds, olive blob with white text on sand. An empty href (address not known yet) points nowhere.
import type { HTMLAttributes } from 'astro/types';
import { blob, blobShape } from '../lib/ui';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  tone?: 'sand' | 'olive';
}

const { href, tone = 'sand', class: className, ...rest } = Astro.props;
const external = /^https?:\/\//.test(href);
---

<a
  href={href || '#'}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  class:list={[
    blob,
    'relative inline-flex items-center justify-center px-26 pt-14 pb-15 text-btn font-bold whitespace-nowrap outline-none',
    tone === 'sand' ? 'text-olive' : 'text-white',
    className,
  ]}
  {...rest}
>
  <svg viewBox="0 0 113 53" preserveAspectRatio="none" aria-hidden="true" class:list={[blobShape, tone === 'sand' ? 'text-sand' : 'text-olive']}>
