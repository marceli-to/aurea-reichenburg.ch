---
// Olive bar with logo and navigation, sticky at the top. Below lg: logo and burger, the menu is a full-screen olive
// dialog. On the home page from lg (as in Figma) the header is part of the hero: transparent, olive links, no logo
// (the hero shows the big one), and it scrolls away with the hero. A second, fixed olive bar slides down once the hero
// is scrolled past and slides back up when it comes back.
// Figma: desktop bar 120 px, 205 px margins, logo 144 px, links 24 px bold 100 px apart; mobile bar 100 px,
// 20 px margins, logo 96 px, burger 40 × 22 (three 4 px bars), menu links 42 px bold 20 px apart.
import Logo from '../assets/icons/logo-aurea.svg';
import { nav } from '../data/site';

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, '/');
const links = nav.map((item) => ({ ...item, active: path === item.href }));
const linkClass = 'block py-8 text-nav font-bold transition duration-150';
---

<header
  data-header
  class:list={[
    'top-0 z-30 h-100 w-full bg-olive text-white lg:h-120',
    overlay ? 'fixed lg:absolute lg:bg-transparent lg:text-olive' : 'sticky',
  ]}
>
  <div class="flex h-full items-center justify-between px-20 md:px-64 lg:px-gutter">
    <a href="/" class:list={['block w-96 text-white lg:w-144', overlay && 'lg:hidden']}>
      <span class="sr-only">auréa Reichenburg – zur Startseite</span>
      <Logo class="h-auto w-full" aria-hidden="true" />
    </a>

    <nav aria-label="Hauptnavigation" class="max-lg:hidden absolute left-1/2 -translate-x-1/2">
      <ul class="flex gap-x-60 xl:gap-x-100">
        {
          links.map(({ label, href, active }) => (
            <li>
              <a
                href={href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  linkClass,
                  // Transparent home header (Figma Navi-Punkt «Grün»): stays olive, hover at 60 % opacity
                  overlay ? 'hover:opacity-60' : 'hover:text-sand',
                  active && 'text-sand',
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      data-menu-open
      aria-haspopup="dialog"
      aria-controls="menu"
      class="-mr-4 grid size-48 cursor-pointer place-content-center lg:hidden"
    >
      <span class="sr-only">Menü öffnen</span>
      <svg width="40" height="22" viewBox="0 0 40 22" aria-hidden="true"><path d="M0 2h40M0 11h40M0 20h40" stroke="currentColor" stroke-width="4"></path></svg>
    </button>
  </div>

  {
    overlay && (
      // Home page from lg: fixed bar that slides down once the hero is scrolled past. Hidden (and so out of the tab
      // order and the accessibility tree) until then.
      <div
        data-header-bar
        class="invisible fixed inset-x-0 top-0 h-120 -translate-y-full bg-olive text-white transition-[translate,visibility] duration-800 ease-out max-lg:hidden [&.is-visible]:visible [&.is-visible]:translate-y-0"
      >
        <div class="flex h-full items-center px-gutter">
          <a href="/" class="block w-144">
            <span class="sr-only">auréa Reichenburg – zur Startseite</span>
            <Logo class="h-auto w-full" aria-hidden="true" />
          </a>
          <nav aria-label="Hauptnavigation" class="absolute left-1/2 -translate-x-1/2">
            <ul class="flex gap-x-60 xl:gap-x-100">
              {links.map(({ label, href, active }) => (
                <li>
                  <a href={href} aria-current={active ? 'page' : undefined} class:list={[linkClass, 'hover:text-sand', active && 'text-sand']}>
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
    )
  }

  {/* Fades in and out; the page keeps its scrollbar while the menu is open */}
  <dialog
    id="menu"
    aria-label="Menü"
    tabindex="-1"
    class="fixed inset-0 m-0 size-full max-h-none max-w-none overflow-y-auto bg-olive text-sand opacity-0 outline-none transition-[opacity,overlay,display] transition-discrete duration-300 backdrop:bg-transparent open:opacity-100 starting:open:opacity-0 lg:hidden"
  >
    <div class="flex h-100 items-center justify-between px-20 md:px-64">
      <a href="/" class="block w-96 text-white">
        <span class="sr-only">auréa Reichenburg – zur Startseite</span>
        <Logo class="h-auto w-full" aria-hidden="true" />
      </a>
      <button type="button" data-menu-close class="-mr-4 grid size-48 cursor-pointer place-content-center text-white">
        <span class="sr-only">Menü schliessen</span>
        <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true"><path d="M6 6l28 28M34 6L6 34" stroke="currentColor" stroke-width="4"></path></svg>
      </button>
    </div>
    <nav aria-label="Hauptnavigation" class="px-20 pt-60 md:px-64">
      <ul class="space-y-20">
        {
          nav.map(({ label, href }) => (
            <li>
              <a href={href} aria-current={path === href ? 'page' : undefined} class="text-menu font-bold transition-colors hover:text-white aria-[current=page]:text-white">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </dialog>
</header>

<script>
  const menu = document.querySelector<HTMLDialogElement>('#menu');
  if (menu) {
    document.querySelector('[data-menu-open]')?.addEventListener('click', () => {
      menu.showModal();
      menu.focus();
    });
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
    // The menu only exists below lg: close it when the window grows past that, or the page stays inert
    matchMedia('(width >= 64rem)').addEventListener('change', (event) => event.matches && menu.close());
  }

  // Home page from lg: the fixed bar slides down once the hero has scrolled behind it
  const bar = document.querySelector<HTMLElement>('[data-header-bar]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (bar && hero) {
    new IntersectionObserver(([entry]) => bar.classList.toggle('is-visible', !entry.isIntersecting), {
      rootMargin: '-120px 0px 0px 0px',
    }).observe(hero);
  }
</script>
